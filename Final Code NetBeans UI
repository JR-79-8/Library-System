import java.util.ArrayList;
import javax.swing.*;
import javax.swing.table.DefaultTableModel;

public class BookStoreUI extends JFrame {
    private static class Book {
        String author;
        String genre;
        String title;
        int bookNumber;
        int stock;
        public Book(String author, String genre, String title, int bookNumber, int stock) {
            this.author = author;
            this.genre = genre;
            this.title = title;
            this.bookNumber = bookNumber;
            this.stock = stock;
        }
    }
    
    private ArrayList<Book> books = new ArrayList<>();
    private DefaultTableModel bookTableModel, cartTableModel;
    private JTable bookTable, cartTable;
    private JComboBox<String> searchTypeCombo;
    private JTextField searchField, txtTitle, txtAuthor, txtGenre, txtBookNo, txtStock;
    private JButton btnSearch, btnAddToCart, btnAddBook, btnRemoveBook;
    private ArrayList<Book> cart = new ArrayList<>();

    public BookStoreUI() {
        setTitle("Book Store");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(900, 600);
        setLayout(null);

        // Sample Books
        books.add(new Book("George Orwell", "Fiction", "1984", 1, 20 ));
        books.add(new Book("Albert Camus", "Fiction", "The Stranger", 2, 20 ));
        books.add(new Book("Erik Larson", "True Crime", "The Devil in the White City", 3, 20));
        books.add(new Book("Robert Greene", "Self Help", "The 48 Laws of Power", 4, 1));
        books.add(new Book("Ta-Nehisi Coates", "Biography", "Between the World and Me", 5, 20));
        books.add(new Book("C.M. Kösemen", "Sci-Fi", "All Tomorrows", 6,20));

        // Book Table Setup
        String[] colNames = {"Book Number","Title","Author","Genre","Stock"};
        bookTableModel = new DefaultTableModel(colNames, 0);
        bookTable = new JTable(bookTableModel);
        JScrollPane bookScroll = new JScrollPane(bookTable);
        bookScroll.setBounds(20, 50, 400, 200);
        add(bookScroll);

        // Cart Table Setup
        String[] cartCols = {"Title"};
        cartTableModel = new DefaultTableModel(cartCols, 0);
        cartTable = new JTable(cartTableModel);
        JScrollPane cartScroll = new JScrollPane(cartTable);
        cartScroll.setBounds(460, 50, 200, 200);
        add(cartScroll);

        // Search Setup
        JLabel lblSearch = new JLabel("Search by:");
        lblSearch.setBounds(20, 10, 70, 30);
        add(lblSearch);
        searchTypeCombo = new JComboBox<>(new String[]{"Book Number","Genre","Author"});
        searchTypeCombo.setBounds(100, 10, 120, 30);
        add(searchTypeCombo);

        searchField = new JTextField();
        searchField.setBounds(230, 10, 120, 30);
        add(searchField);

        btnSearch = new JButton("Search");
        btnSearch.setBounds(360, 10, 80, 30);
        add(btnSearch);

        btnAddToCart = new JButton("Add to Cart");
        btnAddToCart.setBounds(20, 260, 120, 30);
        add(btnAddToCart);

        // Book Add Section
        JLabel lblAddSec = new JLabel("Add Book:");
        lblAddSec.setBounds(20, 300, 100, 20);
        add(lblAddSec);

        JLabel lblBookNo = new JLabel("Book #");
        lblBookNo.setBounds(20, 330, 50, 20);
        add(lblBookNo);
        txtBookNo = new JTextField();
        txtBookNo.setBounds(70, 330, 50, 20);
        add(txtBookNo);

        JLabel lblTitle = new JLabel("Title");
        lblTitle.setBounds(140, 330, 30, 20);
        add(lblTitle);
        txtTitle = new JTextField();
        txtTitle.setBounds(180, 330, 100, 20);
        add(txtTitle);

        JLabel lblAuthor = new JLabel("Author");
        lblAuthor.setBounds(300, 330, 50, 20);
        add(lblAuthor);
        txtAuthor = new JTextField();
        txtAuthor.setBounds(350, 330, 100, 20);
        add(txtAuthor);

        JLabel lblGenre = new JLabel("Genre");
        lblGenre.setBounds(20, 360, 50, 20);
        add(lblGenre);
        txtGenre = new JTextField();
        txtGenre.setBounds(70, 360, 100, 20);
        add(txtGenre);

        JLabel lblStock = new JLabel("Stock");
        lblStock.setBounds(190, 360, 40, 20);
        add(lblStock);
        txtStock = new JTextField();
        txtStock.setBounds(230, 360, 50, 20);
        add(txtStock);

        btnAddBook = new JButton("Add Book");
        btnAddBook.setBounds(300, 360, 120, 30);
        add(btnAddBook);

        // Remove Book Section
        btnRemoveBook = new JButton("Remove Selected Book");
        btnRemoveBook.setBounds(150, 260, 200, 30);
        add(btnRemoveBook);

        refreshBookTable(books);

        // Action listeners
        btnSearch.addActionListener(e -> doSearch());
        btnAddToCart.addActionListener(e -> addToCart());
        btnAddBook.addActionListener(e -> addNewBook());
        btnRemoveBook.addActionListener(e -> removeSelectedBook());

        // Cart "View" Button (optional)
        JButton btnViewCart = new JButton("View Cart");
        btnViewCart.setBounds(460, 260, 120, 30);
        add(btnViewCart);
        btnViewCart.addActionListener(e -> showCart());

        setVisible(true);
    }

    private void refreshBookTable(ArrayList<Book> list){
        bookTableModel.setRowCount(0);
        for(Book b : list){
            if (b.bookNumber > 0)
                bookTableModel.addRow(new Object[]{b.bookNumber, b.title, b.author, b.genre, b.stock});
        }
    }

    private void doSearch(){
        String type = (String) searchTypeCombo.getSelectedItem();
        String search = searchField.getText().trim();
        ArrayList<Book> result = new ArrayList<>();
        for (Book b : books) {
            if (b.bookNumber <= 0) continue;
            if (type.equals("Book Number") && String.valueOf(b.bookNumber).equals(search)) result.add(b);
            else if (type.equals("Genre") && b.genre.equalsIgnoreCase(search)) result.add(b);
            else if (type.equals("Author") && b.author.equalsIgnoreCase(search)) result.add(b);
        }
        if (result.isEmpty())
            JOptionPane.showMessageDialog(this, "No books found!", "Search", JOptionPane.INFORMATION_MESSAGE);
        refreshBookTable(result);
    }

    private void addToCart(){
        int row = bookTable.getSelectedRow();
        if (row == -1) {
            JOptionPane.showMessageDialog(this, "Select a book to add!", "Add to Cart", JOptionPane.WARNING_MESSAGE);
            return;
        }
        int bookNum = (int) bookTableModel.getValueAt(row, 0);
        for(Book b : books){
            if(b.bookNumber == bookNum){
                if (b.stock == 0) {
                    JOptionPane.showMessageDialog(this, "Book out of stock!", "Cart", JOptionPane.WARNING_MESSAGE);
                    return;
                }
                cart.add(b);
                b.stock--;
                JOptionPane.showMessageDialog(this, "Added to cart!\nStock left: "+b.stock, "Cart", JOptionPane.INFORMATION_MESSAGE);
                break;
            }
        }
        refreshBookTable(books);
    }

    private void addNewBook(){
        try {
            int num = Integer.parseInt(txtBookNo.getText());
            String title = txtTitle.getText().trim();
            String author = txtAuthor.getText().trim();
            String genre = txtGenre.getText().trim();
            int stock = Integer.parseInt(txtStock.getText().trim());
            books.add(new Book(author, genre, title, num, stock));
            refreshBookTable(books);
            JOptionPane.showMessageDialog(this, "Book Added!", "Success", JOptionPane.INFORMATION_MESSAGE);
            txtBookNo.setText(""); txtTitle.setText(""); txtAuthor.setText(""); txtGenre.setText(""); txtStock.setText("");
        } catch (Exception ex){
            JOptionPane.showMessageDialog(this, "Invalid entry!", "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void removeSelectedBook(){
        int row = bookTable.getSelectedRow();
        if (row == -1) {
            JOptionPane.showMessageDialog(this, "Select a book to remove!", "Remove Book", JOptionPane.WARNING_MESSAGE);
            return;
        }
        int bookNum = (int) bookTableModel.getValueAt(row, 0);
        for(Book b : books){
            if(b.bookNumber == bookNum){
                b.bookNumber = -1; // mark as removed
                JOptionPane.showMessageDialog(this, "Book Removed!", "Remove", JOptionPane.INFORMATION_MESSAGE);
                break;
            }
        }
        refreshBookTable(books);
    }

    private void showCart(){
        cartTableModel.setRowCount(0);
        for(Book b : cart){
            cartTableModel.addRow(new Object[]{b.title});
        }
        JOptionPane.showMessageDialog(this, new JScrollPane(cartTable), "Cart Contents", JOptionPane.INFORMATION_MESSAGE);
    }

    public static void main(String[] args){
        SwingUtilities.invokeLater(BookStoreUI::new);
    }
}
